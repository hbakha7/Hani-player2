<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="12dp"
    android:background="#CC000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/exo_rew"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_media_rew"
            android:contentDescription="تأخير"
            android:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/exo_play"
            android:layout_width="56dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_media_play"
            android:contentDescription="تشغيل"
            android:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/exo_pause"
            android:layout_width="56dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_media_pause"
            android:contentDescription="إيقاف مؤقت"
            android:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/exo_ffwd"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_media_ff"
            android:contentDescription="تقديم"
            android:tint="#FFFFFF" />
    </LinearLayout>

    <androidx.media3.ui.DefaultTimeBar
        android:id="@id/exo_progress"
        android:layout_width="match_parent"
        android:layout_height="28dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@id/exo_position"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="#FFFFFF"
            android:padding="4dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="103 IPTV"
            android:textColor="#FFFFFF"
            android:gravity="center" />

        <TextView
            android:id="@id/exo_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="#FFFFFF"
            android:padding="4dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/quality_button"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:text="الجودة"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:backgroundTint="#193E52" />

        <Button
            android:id="@+id/aspect_button"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:text="ملاءمة الصورة"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:backgroundTint="#193E52" />

        <Button
            android:id="@+id/exit_fullscreen"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:text="إغلاق"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:backgroundTint="#193E52" />
    </LinearLayout>

</LinearLayout>
